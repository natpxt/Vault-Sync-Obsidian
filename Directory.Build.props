<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath Condition="'$(VaultSyncBuildRoot)' != ''">$(VaultSyncBuildRoot)/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <BaseOutputPath Condition="'$(VaultSyncBuildRoot)' != ''">$(VaultSyncBuildRoot)/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
